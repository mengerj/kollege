# Kollege configuration — copy to .env and adjust. NEVER commit .env.
# Alle Kommandos laufen aus dem Repo-Wurzelverzeichnis, deshalb liegt .env hier
# und nicht in den einzelnen Apps.
# Agent-Einstellungen werden über apps/agent_client/src/kollege/config.py
# gelesen (pydantic-settings, Präfix KOLLEGE_).

# --- LLM / Agent ---
# Provider: "ollama" (lokal-first default) | "anthropic" | "openai" | "openrouter"
KOLLEGE_LLM_PROVIDER=ollama
# Model name as understood by the provider.
#   ollama:     e.g. "qwen2.5:7b-instruct" (tool-calling capable) — pull via `ollama pull`
#   anthropic:  e.g. "claude-sonnet-4-6"
#   openrouter: e.g. "mistralai/mistral-medium-3.1" — siehe apps/agent_client/docs/benchmark.md
KOLLEGE_LLM_MODEL=qwen2.5:7b-instruct
# OpenAI-compatible base URL for Ollama.
KOLLEGE_OLLAMA_BASE_URL=http://localhost:11434/v1
# Cloud keys (only if provider is anthropic/openai). Leave empty for lokal-first.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- OpenRouter ---
# Bewusste Abwägung für die Testphase: über OpenRouter ist für Mistral kein
# Zero Data Retention verfügbar, wohl aber der Ausschluss von Training auf den
# Daten. Das ist akzeptiert — mit erfundenen Daten unkritisch, vor echten
# Kundendaten erneut prüfen.
# KOLLEGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# KOLLEGE_OPENROUTER_API_KEY=

# --- Storage: Agent (noch SQLite) ---
KOLLEGE_DB_PATH=data/kollege.db
KOLLEGE_MARKDOWN_DIR=data/projects

# --- Storage: Postgres (apps/db) ---
# Passt zu apps/db/docker-compose.yml. Noch von keinem Client benutzt —
# der Agent liegt weiterhin auf SQLite.
DATABASE_URL=postgresql://kollege:kollege@localhost:5432/kollege

# --- Signal (via signal-cli-rest-api Docker container) ---
KOLLEGE_SIGNAL_API_URL=http://localhost:8080
# Your linked Signal number in international format, e.g. +49170...
KOLLEGE_SIGNAL_NUMBER=

# --- E-Mail (zurückgestellt, t-online IMAP read-only) ---
# KOLLEGE_IMAP_HOST=secureimap.t-online.de
# KOLLEGE_IMAP_PORT=993
# KOLLEGE_IMAP_USER=
# KOLLEGE_IMAP_PASSWORD=

# --- LLM-Traces (Live-Debugging) ---
# Opt-in, enthält Volltext (Prompts/Tool-Calls) — Datensparsamkeit:
# nur für Debugging-Phasen aktivieren, siehe
# apps/agent_client/docs/live-testing-guide.md §3e.
# KOLLEGE_TRACE=1
# KOLLEGE_TRACE_DIR=data/traces

# --- Proaktive Erinnerungen ---
# TOML-Datei mit dem Zeitplan (Ping/Aufgabenliste je Wochentag+Uhrzeit).
# Beispiel zum Kopieren: apps/agent_client/docs/reminders.example.toml.
# Fehlt die Datei, werden keine Erinnerungen versendet.
# KOLLEGE_REMINDERS_CONFIG_PATH=data/reminders.toml
